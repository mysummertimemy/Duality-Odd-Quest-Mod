@1  = ~Kim jesteœcie? Niewa¿ne, przyby³em podbiæ to nêdzne miasteczko. To tylko krótki przystanek na mojej drodze do podboju œwiata. Padnijcie na kolana przed swoim nowym panem, a mo¿e oszczêdzê wasze ¿a³osne ¿ycia.~
@2  = ~Um. Czy ty w ogóle wiesz, z kim masz do czynienia, czy jesteœ po prostu kolejnym têpym megalomanem? Stawiam na to drugie.~
@3  = ~Yyy. Czeœæ.~
@4  = ~Bogowie, tylko nie kolejny. Czy ja dzia³am jak magnes na szaleñców, czy coœ jest w tej wodzie?~
@5  = ~Co? Robak œmie siê do mnie odzywaæ? No dobrze, marnoto, mów.~
@6  = ~Niech to, czemu, czemu, czemu zawsze ja? Odejdziesz po dobroci, czy mam ci roztrzaskaæ czaszkê?~
@7  = ~Yyy. W czym mo¿emy pomóc?~
@8  = ~Œmiesz... mnie... obra¿aæ?! Ha! Nie splamiê ostrza krwi¹ kogoœ tak ¿a³osnego jak ty. Padnijcie przed moimi s³ugami!~
@9  = ~Daj spokój i zmykaj.~
@10 = ~Wszyscy mówili, ¿e jestem szalony, ale jeszcze im poka¿ê... Udowodniê, ¿e nasz wszechœwiat jest tylko ziarenkiem piasku na nieskoñczonej wydmie! Ups. Nie ta gra s³ów. Ee, no dobrze, chyba ju¿ sobie pójdê.~
@11 = ~Chyba siê zaraz rozp³aczê.~
@12 = ~Chcesz poznaæ historiê mojego ¿ycia? Bardzo dobrze. Na pocz¹tku: urodzi³em siê...~
@13 = ~W³aœciwie to nie pyta³em o twoj¹ biografiê, tylko co ty tu, na dziewiêæ piekie³, robisz. Tak ¿ebym wiedzia³, czy warto ciê zabijaæ.~~W³aœciwie to nie pyta³am o twoj¹ biografiê, tylko co ty tu, na dziewiêæ piekie³, robisz. Tak ¿ebym wiedzia³a, czy warto ciê zabijaæ.~
@14 = ~Ee, przerywam z niechêci¹, ale czy mo¿emy skoñczyæ tê gadkê i przejœæ do czêœci, gdzie leje siê krew?~
@15 = ~Och. A nie chcesz pos³uchaæ tragicznej historii mojej przesz³oœci?~
@16 = ~Nieszczególnie. I tak zamierzam ciê zabiæ, wiêc co mnie obchodzi twoja tragiczna przesz³oœæ?~
@17 = ~*wzdycha* No dobrze. Jakbym mia³ coœ lepszego do roboty. Na przyk³ad ratowanie elfiego miasta przed ob³¹kanym szaleñcem.~~*wzdycha* No dobrze. Jakbym mia³a coœ lepszego do roboty. Na przyk³ad ratowanie elfiego miasta przed ob³¹kanym szaleñcem.~
@18 = ~Bardzo dobrze, marny œmiertelniku. Módl siê do swoich bogów, zanim ciê zmia¿d¿ê.~~Bardzo dobrze, marna œmiertelniczko. Módl siê do swoich bogów, zanim ciê zmia¿d¿ê.~
@19 = ~No to co, czas na rozróbê!~
@20 = ~Niech bêdzie, wszystko zaczê³o siê w Czasie Niepokojów, gdy bogowie chodzili po ziemi. Jak zapewne wiesz, zmar³y bóg Bhaal sp³odzi³ ze œmiertelnymi wiele dzieci, które mia³y pomóc w jego zmartwychwstaniu. Ja jestem jednym z tych dzieci, a moja matka by³a potê¿nym magiem w s³u¿bie jednej ze œwi¹tyñ Bhaala. Kiedy nadszed³ czas, by mnie z³o¿yæ w ofierze, matka nie znios³a tego i potajemnie mnie wykrad³a.~
@21 = ~I czemu ma mnie to niby obchodziæ?~
@22 = ~O rany, kolejny z mego rodzeñstwa z idiotycznymi marzeniami o podboju œwiata. No dalej, i tak to wszystko skoñczy siê rzezi¹~
@23 = ~Cisza, œmiertelniku! Pozwól przemawiaæ lepszym od siebie. Ahem. Jak JU¯ mówi³em, moja matka wykrad³a mnie, ale zosta³a ciê¿ko ranna. Nied³ugo potem zmar³a, zostawiaj¹c mnie, ma³e dziecko, samego w tym okrutnym, okropnym œwiecie.~~Cisza, œmiertelniczko! Pozwól przemawiaæ lepszym od siebie. Ahem. Jak JU¯ mówi³em, moja matka wykrad³a mnie, ale zosta³a ciê¿ko ranna. Nied³ugo potem zmar³a, zostawiaj¹c mnie, ma³e dziecko, samego w tym okrutnym, okropnym œwiecie.~
@24 = ~Dobra, mam doœæ tej ³zawej historyjki. Czas umieraæ.~
@25 = ~Proszê, mów dalej, wygl¹da na to, ¿e mia³eœ naprawdê okropne dzieciñstwo.~
@26 = ~Œmiesz traktowaæ mnie protekcjonalnie?! Masz choæ pojêcie, z kim zadar³eœ? Giñ, bezczelny!~~Œmiesz traktowaæ mnie protekcjonalnie?! Masz choæ pojêcie, z kim zadar³aœ? Giñ, bezczelna!~
@27 = ~Ups. To akurat mog³em przewidzieæ.~~Ups. To akurat mog³am przewidzieæ.~
@28 = ~Zabi³eœ mojego syna, wiêc teraz ja rozprawiê siê z tob¹ osobiœcie. Przygotuj siê na wieczne mêki! Brzmi zbyt melodramatycznie? Nie mogê jakoœ wyczuæ odpowiedniej intonacji.~~Zabi³aœ mojego syna, wiêc teraz ja rozprawiê siê z tob¹ osobiœcie. Przygotuj siê na wieczne mêki! Brzmi zbyt melodramatycznie? Nie mogê jakoœ wyczuæ odpowiedniej intonacji.~
@29 = ~Trochê. Ta ca³a wiecznoœæ by³a chyba lekk¹ przesad¹, ale co tam, i tak zaraz bêdziemy siê szlachtowaæ...~
@30 = ~Wcale nie. Przed chwil¹ posiekaliœmy twojego syna na malutkie kawa³eczki. A teraz czas na ciebie.~

@44 = ~Bêdziesz p³akaæ? Zaczekaj, gdzieœ tu mam chusteczkê...~
@45 = ~Grzebie w ogromnym plecaku...~
@46 = ~Czekaj! Próbujesz mnie oszukaæ! Przecie¿ ja nawet nie mam chusteczki! Moi s³udzy was zniszcz¹.~
@47 = ~Czy ja naprawdê nigdy nie mogê walczyæ z JAKIMŒ normalnym z³oczyñc¹? Naprawdê wymagam zbyt wiele?~
@48 = ~Zaraz, nie mówcie mi, ¿e jesteœcie kolejn¹ band¹ œwiêtoszków, co zawsze wtykaj¹ nos w wielkie plany biednego Dzieciêcia Bhaala. Naprawdê nie macie NIC lepszego do roboty? Nie wiem, pomagaæ staruszkom przechodziæ przez ulicê czy coœ? Tak czy inaczej, przejmujê to miasto! I tym razem z³o ma ca³kiem niez³e szanse na wygran¹!~

