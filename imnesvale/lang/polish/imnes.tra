@31 = ~B³agam, panie! Musicie ochroniæ nasz¹ biedn¹ wioskê! Na pó³noc st¹d pewien z³y mag przejmuje kolejne osady. Zamienia mieszkañców w niewolników swojej rosn¹cej armii! Ja zostanê tutaj i zorganizujê nasz¹ obronê. Reszta zebra³a siê ju¿ w gospodzie.~
@32 = ~Oczywiœcie, zacny burmistrzu, przecie¿ nie ma opcji, ¿ebym odmówi³? (Kto pisze te durne kwestie?)~~Oczywiœcie, zacny burmistrzu, przecie¿ nie ma opcji, ¿ebym odmówi³a? (Kto pisze te durne kwestie?)~
@33 = ~Nie s¹dzê. RadŸcie sobie sami.~
@34 = ~Mój panie, po raz kolejny przychodzisz nam z pomoc¹ w godzinie potrzeby. Pamiêtaj proszê: jeœli moja ¿ona albo ja zginiemy, nasza mizerna obrona runie i wszystko bêdzie stracone. Chroñ nas za wszelk¹ cenê. Ha. Nareszcie g³upi cywile nie mog¹ zostaæ wyr¿niêci bez konsekwencji.~~Moja pani, po raz kolejny przychodzisz nam z pomoc¹ w godzinie potrzeby. Pamiêtaj proszê: jeœli moja ¿ona albo ja zginiemy, nasza mizerna obrona runie i wszystko bêdzie stracone. Chroñ nas za wszelk¹ cenê. Ha. Nareszcie g³upi cywile nie mog¹ zostaæ wyr¿niêci bez konsekwencji.~
@35 = ~Oczywiœcie, burmistrzu. Nie lêkaj siê.~
@36 = ~Proszê, mój panie, bez ciebie nie mamy ¿adnych szans!~~Proszê, moja pani, bez ciebie nie mamy ¿adnych szans!~
@37 = ~Bardzo dobrze, ale spodziewam siê sowitej nagrody.~
@38 = ~Szlag. W takim razie wygl¹da na to, ¿e faktycznie nie macie szans.~
@39 = ~Dobrze. W takim razie przyjmujemy nasz los i oby bogowie pokarali ciê za to, co uczyni³eœ.~~Dobrze. W takim razie przyjmujemy nasz los i oby bogowie pokarali ciê za to, co uczyni³aœ.~
@40 = ~Ha. Sam kszta³tujê swój los, niezale¿nie od kaprysów bogów.~~Ha. Sama kszta³tujê swój los, niezale¿nie od kaprysów bogów.~

@50 = ~Dowodzi nimi potê¿ny mag Jugend. Ma dwóch poruczników: maga o imieniu Ayrus i maginiê Maiê. Ka¿de z nich prowadzi czêœæ jego armii. Kolejnymi posi³kami dowodzi jego syn. Uwa¿aj na niego, to groŸny wojownik, z którym nie warto zadzieraæ.~
@51 = ~Mówi siê, ¿e jego armia jest niemal nieskoñczona, ale ¿eby sprowadzaæ posi³ki, jego dwaj porucznicy i syn musz¹ utrzymywaæ otwarte portale.~
@52 = ~Zabijaj¹c jego syna, zamkniesz dwa dolne portale, a zabijaj¹c jego poruczników, zamkniesz trzy górne.~
@53 = ~Chcesz, ¿ebym opowiedzia³ ci ca³¹ masê rzeczy o Jugendzie i jego armii, o których zgo³a nie powinienem mieæ pojêcia?~
@54 = ~Jasne. Uwielbiam, kiedy postacie dok³adnie wyk³adaj¹ mi, co mam zrobiæ.~
@55 = ~Nie, dziêki. Lubiê sam dochodziæ do pewnych rzeczy. No, chyba ¿e zginê piêæ czy szeœæ razy, wtedy wrócê po tê drug¹ opcjê.~ ~Nie, dziêki. Lubiê sama dochodziæ do pewnych rzeczy. No, chyba ¿e zginê piêæ czy szeœæ razy, wtedy wrócê po tê drug¹ opcjê.~
@56 = ~Ci, którym wczeœniej przyszed³eœ z pomoc¹, teraz sami ci jej udziel¹. Wykorzystaj ich dobrze. Mamy tylko kilka minut, nim zaatakuj¹. I pamiêtaj, NIE POZWÓL MI ZGIN¥Æ. Powodzenia. Ten informator ulegnie samozniszczeniu za 5 sekund.~ ~Ci, którym wczeœniej przysz³aœ z pomoc¹, teraz sami ci jej udziel¹. Wykorzystaj ich dobrze. Mamy tylko kilka minut, nim zaatakuj¹. I pamiêtaj, NIE POZWÓL MI ZGIN¥Æ. Powodzenia. Ten informator ulegnie samozniszczeniu za 5 sekund.~
@57 = ~Yyy. No tak. Dobrze...~
